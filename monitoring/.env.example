# Monitoring Stack Environment Variables
# 监控系统环境变量配置

# Grafana 配置
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# MySQL Exporter 配置
# 格式: username:password@(host:port)/database
MYSQL_EXPORTER_DSN=root:root123456@(mysql:3306)/ev_charging_system

# Redis Exporter 配置
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# Alertmanager 邮件配置（可选）
ALERTMANAGER_SMTP_FROM=alertmanager@ev-charging.com
ALERTMANAGER_SMTP_HOST=smtp.example.com:587
ALERTMANAGER_SMTP_USERNAME=alertmanager@ev-charging.com
ALERTMANAGER_SMTP_PASSWORD=your-password-here

# 钉钉机器人 Token（可选）
DINGTALK_TOKEN=

# 企业微信机器人 Key（可选）
WECHAT_WEBHOOK_KEY=
