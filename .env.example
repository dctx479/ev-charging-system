# ==========================================
# EV Charging System - 环境变量配置模板
# ==========================================
# 复制此文件为 .env 并填入实际值
# 警告: .env 文件包含敏感信息，不要提交到版本控制
# 注意: 标记为 [必需] 的变量必须设置，否则服务无法启动

# ==========================================
# 数据库配置 (MySQL) [必需]
# ==========================================
# 使用强密码: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MYSQL_DATABASE=ev_charging_system
MYSQL_USER=evuser
MYSQL_PASSWORD=CHANGE_ME_STRONG_USER_PASSWORD
MYSQL_PORT=3306

# ==========================================
# Redis 配置
# ==========================================
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ==========================================
# RabbitMQ 配置 [必需]
# ==========================================
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ==========================================
# JWT 认证配置 [必需]
# ==========================================
# 安全警告: 必须使用强随机密钥!
# 生成命令: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
JWT_EXPIRATION=86400000

# ==========================================
# 应用端口配置
# ==========================================
BACKEND_PORT=8080
AI_SERVICE_PORT=5000
FRONTEND_USER_PORT=5173
FRONTEND_ADMIN_PORT=5174

# ==========================================
# AI 服务配置
# ==========================================
AI_CONNECT_TIMEOUT=5000
AI_READ_TIMEOUT=10000
# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
# API密钥认证（可选）
AI_API_KEY_ENABLED=false
AI_API_KEY=

# ==========================================
# Spring Boot 配置
# ==========================================
SPRING_PROFILES_ACTIVE=docker
# JPA配置: validate (生产环境) 或 update (开发环境)
DDL_AUTO=validate
SHOW_SQL=false
LOG_LEVEL=info
SQL_LOG_LEVEL=warn

# ==========================================
# Flask 配置
# ==========================================
# production (生产环境) 或 development (开发环境)
FLASK_ENV=production

# ==========================================
# 前端 API 配置
# ==========================================
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws

# ==========================================
# 高德地图 API (可选)
# ==========================================
# 前往 https://console.amap.com 获取
AMAP_KEY=your_amap_api_key
AMAP_SECURITY_CODE=your_amap_security_code
