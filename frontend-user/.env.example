# ==========================================
# EV Charging System 用户端前端 - 环境变量配置
# ==========================================
# 复制此文件为 .env.local 并填入实际值

# 高德地图 API Key（前往 https://console.amap.com 获取）
VITE_AMAP_KEY=your_amap_api_key
VITE_AMAP_SECURITY_CODE=your_amap_security_code

# 腾讯地图 API Key（前往 https://lbs.qq.com 获取）
VITE_TENCENT_MAP_KEY=your_tencent_map_key

# 百度地图 API Key（前往 https://lbsyun.baidu.com 获取）
VITE_BAIDU_MAP_KEY=your_baidu_map_key

# 后端 API 地址
VITE_API_BASE_URL=http://localhost:8080/api
