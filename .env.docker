# ============================================
# EV Charging System - Docker Environment Variables
# ============================================

# MySQL 数据库配置
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=ev_charging_system
MYSQL_USER=evuser
MYSQL_PASSWORD=evpass123

# Redis 配置 (可选密码)
REDIS_PASSWORD=

# RabbitMQ 配置
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123

# JWT 配置
JWT_SECRET=your-secret-key-please-change-in-production-environment

# Flask 环境
FLASK_ENV=development

# 前端 API 配置
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws
